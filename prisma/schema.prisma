generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Status {
  WAITING
  INPROGRESS
  DONE
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String
  password  String
  role      Role
  createdAt DateTime  @default(now())
  Project   Project[]
  Session   Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  loggedAt  DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

model Project {
  id     String @id @default(cuid())
  name   String
  tasks   Task[]
  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Task {
  id          String   @id @default(cuid())
  name        String
  description String
  dueDate     DateTime
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  priority    Priority
  status      Status
  createdAt   DateTime @default(now())

  @@unique([projectId, name])
}
